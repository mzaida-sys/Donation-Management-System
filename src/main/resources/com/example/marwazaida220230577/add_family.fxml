<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane alignment="CENTER" hgap="10" prefHeight="468.0" prefWidth="628.0" style="-fx-padding: 20;" vgap="10" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.marwazaida220230577.AddFamilyController">

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Add New Family" textFill="#5680a1" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0" />

    <Label text="Family Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

    <Label text="Members Count:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
    <TextField fx:id="membersField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

    <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
    <TextField fx:id="addressField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

    <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
    <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="4" />

    <Label text="Social Status:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
    <ComboBox fx:id="statusComboBox" GridPane.columnIndex="1" GridPane.rowIndex="5" />

    <Label text="Notes:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
    <TextArea fx:id="notesArea" prefRowCount="2" GridPane.columnIndex="1" GridPane.rowIndex="6" />

    <Label fx:id="statusLabel" style="-fx-text-fill: red;" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="7" />

    <Button onAction="#handleAddFamily" text="Add Family" textFill="#810083" GridPane.columnIndex="1" GridPane.rowIndex="8" />
    <Button onAction="#handleBack" text="⬅ Back" GridPane.columnIndex="0" GridPane.rowIndex="8" />
    <columnConstraints>
        <ColumnConstraints />
        <ColumnConstraints />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
    </rowConstraints>

</GridPane>
