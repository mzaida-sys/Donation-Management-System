<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500" prefWidth="800" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.example.marwazaida220230577.EditFamilyController">

    <top>
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Edit Family" textFill="#3ea1bc" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <TableView fx:id="familyTable" prefHeight="300">
            <columns>
                <TableColumn fx:id="nameCol" prefWidth="120" text="Name" />
                <TableColumn fx:id="membersCol" prefWidth="80" text="Members" />
                <TableColumn fx:id="addressCol" prefWidth="150" text="Address" />
                <TableColumn fx:id="phoneCol" prefWidth="120" text="Phone" />
                <TableColumn fx:id="statusCol" prefWidth="100" text="Status" />
                <TableColumn fx:id="notesCol" prefWidth="150" text="Notes" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">
            <HBox spacing="10">
                <TextField fx:id="nameField" promptText="Name" />
                <TextField fx:id="membersField" promptText="Members" />
                <TextField fx:id="addressField" promptText="Address" />
            </HBox>
            <HBox spacing="10">
                <TextField fx:id="phoneField" promptText="Phone" />
                <ComboBox fx:id="statusComboBox" />
                <TextField fx:id="notesField" promptText="Notes" />
            </HBox>
            <Label fx:id="statusLabel" style="-fx-text-fill: red;" />
            <HBox spacing="10">
                <Button onAction="#handleUpdate" text="Save Changes" textFill="#337bd3" />
                <Button onAction="#handleBack" text="⬅ Back" textFill="#287fb2" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
