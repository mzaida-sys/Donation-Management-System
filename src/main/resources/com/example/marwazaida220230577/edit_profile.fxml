<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.marwazaida220230577.Edit_profileController"
            prefWidth="500" prefHeight="400">

    <VBox alignment="CENTER" spacing="15" layoutX="50" layoutY="50" prefWidth="400">
        <Label text="Edit profile" style="-fx-font-size: 20px; -fx-text-fill: #2c3e50;" />

        <TextField fx:id="nameField" promptText="full name" />
        <TextField fx:id="emailField" promptText="e-mail" />
        <TextField fx:id="phoneField" promptText="phone number" />

        <Button text="save" onAction="#saveProfile" />
        <Button text="Back" onAction="#handleBack" />
    </VBox>
</AnchorPane>