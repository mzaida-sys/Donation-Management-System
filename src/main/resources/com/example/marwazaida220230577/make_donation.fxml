<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400" prefWidth="600" style="-fx-background-color: #f2f2f2;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.marwazaida220230577.donatenowController">

    <VBox alignment="CENTER" layoutX="50" layoutY="30" prefWidth="500" spacing="15">
        <Label style="-fx-font-size: 20px; -fx-text-fill: #2c3e50;" text="Donate now" />

        <HBox spacing="10">
            <Label text="Select family:" />
            <ComboBox fx:id="familyList" prefWidth="250" />
        </HBox>

        <HBox spacing="10">
            <Label text="Amount:" />
            <TextField fx:id="amountField" prefWidth="250" promptText="Enter the amount" />
        </HBox>

        <HBox spacing="10">
            <Label text="Help type:" />
            <RadioButton fx:id="cashRadio" text="Cash">
            <toggleGroup>
               <ToggleGroup fx:id="id_tt" />
            </toggleGroup></RadioButton>
            <RadioButton fx:id="foodRadio" text="Food parcel" toggleGroup="$id_tt" />
        </HBox>

        <Button onAction="#donateNow" prefWidth="150" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Donate now" />

        <Button onAction="#handleBack" prefWidth="150" style="-fx-background-color: #e53e3e; -fx-text-fill: white;" text="Back" />
    </VBox>

</AnchorPane>
