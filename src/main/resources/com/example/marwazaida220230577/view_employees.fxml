<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="500" prefWidth="800" spacing="15" style="-fx-padding: 20;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.example.marwazaida220230577.ViewEmployeesController">

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Employee List" textFill="#3fbcc9" />

    <TableView fx:id="employeeTable" prefHeight="400" prefWidth="750">
        <columns>
            <TableColumn fx:id="nameCol" prefWidth="120" text="Full Name" />
            <TableColumn fx:id="usernameCol" prefWidth="100" text="Username" />
            <TableColumn fx:id="birthDateCol" prefWidth="100" text="Birth Date" />
            <TableColumn fx:id="genderCol" prefWidth="80" text="Gender" />
            <TableColumn fx:id="positionCol" prefWidth="100" text="Position" />
            <TableColumn fx:id="phoneCol" prefWidth="120" text="Phone" />
        </columns>
    </TableView>

    <Button onAction="#handleBack" prefWidth="100" text="⬅ Back" textFill="#1a6168" />

</VBox>

