<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="448.0" prefWidth="466.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.marwazaida220230577.DonorController">

    <VBox alignment="CENTER" layoutX="80.0" layoutY="50.0" prefHeight="281.0" prefWidth="251.0" spacing="15.0">
      <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@image/image3.jpg" />
         </image>
      </ImageView>
        <Button onAction="#openEditProfile" prefHeight="25.0" prefWidth="250.0" text="Edit profile" />
        <Button onAction="#openViewFamilies" prefHeight="25.0" prefWidth="250.0" text="View cases" />
        <Button onAction="#openMakeDonation" prefHeight="25.0" prefWidth="254.0" text="Donate now" />
        <Button onAction="#openDonationHistory" prefHeight="25.0" prefWidth="251.0" text="History of donations" />
        <Button onAction="#handleLogout" text="Log out" textFill="red" />

    </VBox>

</AnchorPane>
