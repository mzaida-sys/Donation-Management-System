<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.marwazaida220230577.DonationHistoryController"
            prefWidth="600" prefHeight="400">

    <VBox alignment="CENTER" spacing="10" layoutX="30" layoutY="20" prefWidth="540">
        <Label text="Donation record" style="-fx-font-size: 20px; -fx-text-fill: #2c3e50;" />

        <TableView fx:id="historyTable" prefWidth="550">
            <columns>
                <TableColumn fx:id="dateCol" text="the date" prefWidth="150"/>
                <TableColumn fx:id="familyCol" text="Family" prefWidth="150"/>
                <TableColumn fx:id="typeCol" text="Type" prefWidth="120"/>
                <TableColumn fx:id="amountCol" text="Value" prefWidth="100"/>
            </columns>
        </TableView>

        <Button text="Export to file" onAction="#exportHistory" />
        <Button text="Back" onAction="#handleBack"/>
    </VBox>
</AnchorPane>