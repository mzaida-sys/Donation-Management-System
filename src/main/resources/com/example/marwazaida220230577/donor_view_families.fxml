<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.marwazaida220230577.View_familydonorController"
            prefWidth="600" prefHeight="400">

    <VBox alignment="CENTER" spacing="10" layoutX="30" layoutY="20" prefWidth="550">
        <Label text="List of families" style="-fx-font-size: 20px; -fx-text-fill: #2c3e50;" />

        <TableView fx:id="familyTable" prefWidth="550">
            <columns>
                <TableColumn fx:id="nameCol" text="the name" prefWidth="150"/>
                <TableColumn fx:id="countCol" text="Number of individuals" prefWidth="100"/>
                <TableColumn fx:id="addressCol" text="the address" prefWidth="150"/>
                <TableColumn fx:id="phoneCol" text="Phone" prefWidth="150"/>
            </columns>
        </TableView>

        <Button text="Back" onAction="#handleBack"/>
    </VBox>
</AnchorPane>